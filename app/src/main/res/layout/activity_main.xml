<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="自动理包器"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="悬浮窗框选 + Shizuku 触控 + 图像识别自动整理背包"
            android:textSize="14sp"
            android:alpha="0.7" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="状态：未运行"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnStartFloat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/start_float" />

        <Button
            android:id="@+id/btnRequestShizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="授予 Shizuku 权限" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="日志：\n（开启悬浮窗后在悬浮窗内操作）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="使用说明：\n1. 安装 Shizuku 并启动（可用无线调试/Wi-Fi ADB），点击上方“授予 Shizuku 权限”。\n2. 开启悬浮窗后，所有操作都在悬浮窗里完成：整理页选模板→框选背包区域→开始整理；模板页管理用户模板；工具页收集/导出开发者素材。"
            android:textSize="13sp"
            android:alpha="0.85" />
    </LinearLayout>
</ScrollView>